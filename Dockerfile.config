FROM alpine:latest

WORKDIR /config

# Copy all configuration and setup files
COPY docker-compose.yml .
COPY requirements.txt .
COPY dags/ ./dags/
COPY scripts/ ./scripts/
COPY models/ ./models/
COPY api/ ./api/
COPY frontend/ ./frontend/

# Create a script to extract configs
COPY setup.sh .
RUN chmod +x setup.sh

# This container will be used to copy files to the host
CMD ["sh", "-c", "cp -r /config/* /deployment/"]