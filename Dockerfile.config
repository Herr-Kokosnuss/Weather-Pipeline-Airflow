FROM alpine:latest

WORKDIR /config

# Copy all configuration and deployment files
COPY docker-compose.yml .
COPY requirements.txt .
COPY dags/ ./dags/
COPY scripts/ ./scripts/
COPY models/ ./models/
COPY api/ ./api/
COPY frontend/ ./frontend/

# Simple command to copy files to mounted volume
CMD ["cp", "-r", "/config/.", "/deployment/"]